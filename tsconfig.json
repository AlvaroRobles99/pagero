{
  "compilerOptions": {
    // App project: browser code only. No Node or Bun globals in here.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    // Pure TypeScript: every file the project resolves is checked. src/tests stays
    // excluded until the test migration lands; tsconfig.node.json still allows JS for
    // the Vite configs and the scripts.
    "allowJs": false,

    // vite/client declares the CSS-module and static-asset imports.
    "types": ["vite/client"],

    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"],
  "exclude": ["src/tests", "dist", "node_modules"]
}
