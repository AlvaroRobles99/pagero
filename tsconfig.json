{
  "compilerOptions": {
    // App project: browser code only. No Node or Bun globals in here.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    // Migration in progress: .jsx files are resolved by Vite but not type-checked.
    // This tsconfig excludes src/tests until the test migration lands.
    "allowJs": true,
    "checkJs": false,

    // vite/client declares the CSS-module and static-asset imports.
    "types": ["vite/client"],

    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"],
  "exclude": ["src/tests", "dist", "node_modules"]
}
